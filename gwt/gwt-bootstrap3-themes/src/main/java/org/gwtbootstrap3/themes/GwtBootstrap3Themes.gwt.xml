<?xml version="1.0" encoding="UTF-8"?>
<!--
  Swappable Bootstrap 3 stylesheets, vendored from Bootswatch (MIT).

  No stylesheet is declared here: these themes replace bootstrap.css rather than adding
  to it, so the application chooses one at runtime through Themes.apply(). Inherit
  GwtBootstrap3NoTheme alongside this module so nothing else claims the stylesheet.
-->
<module>
    <!-- for org.gwtbootstrap3.client.ui.theme.Theme, which the catalogue returns -->
    <inherits name="org.gwtbootstrap3.GwtBootstrap3NoTheme"/>
    <source path="client"/>
    <public path="client/resource">
        <include name="css/*.css"/>
    </public>
</module>
