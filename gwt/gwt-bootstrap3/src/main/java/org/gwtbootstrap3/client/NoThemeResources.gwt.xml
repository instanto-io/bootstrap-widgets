<module>
    <public path="resource">
        <include name="css/*.css"/>
        <include name="css/*.map"/>
        <include name="js/*.js"/>
        <include name="js/*.map"/>
        <include name="fonts/*"/>
    </public>
    <!--
      Additive, not swappable: the icon font sits on top of whichever Bootstrap
      stylesheet is active and is not replaced when a theme is switched, so it
      belongs here rather than in Resources.
    -->
    <stylesheet src="css/font-awesome-4.7.0.min.cache.css"/>

    <!--
      The library's own stylesheet, additive to Bootstrap rather than a
      replacement for it, so it survives a runtime theme switch the same way
      Font Awesome above does.
    -->
    <stylesheet src="css/gwt-bootstrap3.cache.css"/>
</module>
