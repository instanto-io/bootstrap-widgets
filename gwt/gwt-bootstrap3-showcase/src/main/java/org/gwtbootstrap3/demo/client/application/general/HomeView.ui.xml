<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html">

    <b:Row>
        <b:Column size="XS_12">
            <b:Jumbotron>
                <b:Heading size="H1" text="GWT Bootstrap Showcase"/>

                <b.html:Paragraph>
                    A <a href="https://www.gwtproject.org/">GWT</a> widget library compatibility fork backed by Bootstrap 3.4.1 and jQuery 3.7.1
                </b.html:Paragraph>

                <b.html:Paragraph>
                    This showcase exercises the <a href="https://github.com/cstainton/bootstrap-widgets">gwtbootstrap</a> compatibility modules: the preserved GwtBootstrap3 Java API, refreshed dependencies, and the original Bootstrap 3 widget semantics. Bootstrap 5 work is kept on a separate migration track.
                </b.html:Paragraph>
            </b:Jumbotron>
        </b:Column>
    </b:Row>
</ui:UiBinder>
