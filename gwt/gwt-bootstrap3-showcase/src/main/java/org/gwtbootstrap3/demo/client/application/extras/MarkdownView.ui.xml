<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
             xmlns:b.html="urn:import:org.gwtbootstrap3.client.ui.html"
             xmlns:md="urn:import:org.gwtbootstrap3.extras.markdown.client.ui">

    <b:Container>
        <b:PageHeader text="Markdown"/>

        <b:Row>
            <b:Column size="MD_12">
                <b:Panel>
                    <b:PanelHeader text="Editor"/>
                    <b:PanelBody>
                        <b.html:Paragraph>
                            For applications that store Markdown rather than HTML. The source is kept
                            exactly as typed; the toolbar inserts the syntax, the Preview tab renders it
                            with the same dialect flexmark produces, and the reference sits beneath the
                            editor instead of linking away to another site.
                        </b.html:Paragraph>
                        <md:MarkdownEditor ui:field="editor"/>
                    </b:PanelBody>
                </b:Panel>

                <b:Panel>
                    <b:PanelHeader text="Rendered"/>
                    <b:PanelBody>
                        <md:MarkdownPanel ui:field="rendered"/>
                    </b:PanelBody>
                </b:Panel>
            </b:Column>
        </b:Row>
    </b:Container>

</ui:UiBinder>
