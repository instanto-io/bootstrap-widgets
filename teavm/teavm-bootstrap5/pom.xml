<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>teavm-bootstrap5</artifactId>
  <name>TeaVM Bootstrap 5</name>
  <packaging>jar</packaging>
  <description>Shared Bootstrap 5 widgets and UiBinder templates compiled with TeaVM and gwt-user-compat.</description>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap5</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap5-themes</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap5-extras</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap5-showcase</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-user-compat</artifactId>
    </dependency>
    <!-- The TeaVM side of the JsInterop the shared sources use: compat's Js and
         JsPropertyMap in place of com.google.jsinterop:base, and the annotations,
         which the binding generator leaves imported. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>jsinterop-base-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.jsinterop</groupId>
      <artifactId>jsinterop-annotations</artifactId>
      <version>${jsinterop.annotations.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>
  <properties>
    <shared.source.artifacts>gwt-bootstrap5,gwt-bootstrap5-themes,gwt-bootstrap5-extras,gwt-bootstrap5-showcase</shared.source.artifacts>
    <shared.source.gwt.only>META-INF/**,io/instanto/bootstrap5/extras/markdown/client/MarkdownResources.java,io/instanto/bootstrap5/extras/grid/client/GridResources.java,io/instanto/bootstrap5/extras/sortable/client/SortableResources.java,io/instanto/bootstrap5/extras/gallery/client/GalleryResources.java,io/instanto/bootstrap5/extras/dashboard/client/DashboardResources.java,io/instanto/bootstrap5/extras/select/client/SelectResources.java,io/instanto/bootstrap5/extras/slider/client/SliderResources.java,io/instanto/bootstrap5/extras/datepicker/client/DatePickerResources.java,io/instanto/bootstrap5/extras/richtext/client/RichTextResources.java</shared.source.gwt.only>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>gwt-resources-compat-maven-plugin</artifactId>
        <version>${teavm-compat.version}</version>
        <executions>
          <execution>
            <id>generate-teavm-modules</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/shared-sources</sourceRoot>
              <outputRoot>${project.build.directory}/generated-sources/teavm-modules</outputRoot>
              <assetRoot>${project.build.directory}/teavm</assetRoot>
              <packagedRoot>${project.build.outputDirectory}/META-INF/bootstrap5-assets</packagedRoot>
              <resourcesClass>io.instanto.bootstrap5.client.Bootstrap5Resources</resourcesClass>
              <idPrefix>bootstrap5-</idPrefix>
            </configuration>
          </execution>
          <!-- The GWT sources reach JavaScript through JsInterop. adapt-sources
               rewrites that as TeaVM JSO, so TeaVM compiles the same source rather
               than a hand-kept copy; the compiler reads teavm-sources below. -->
          <execution>
            <id>adapt-shared-sources</id>
            <goals>
              <goal>adapt-sources</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/shared-sources</sourceRoot>
              <outputRoot>${project.build.directory}/teavm-sources</outputRoot>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-shared-bootstrap5-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/teavm-sources</source>
                <source>${project.build.directory}/generated-sources/teavm-modules</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>widget-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
          <excludes>
            <exclude>io/instanto/bootstrap5/client/GwtBootstrap5EntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/datepicker/client/DatePickerClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/datepicker/client/DatePickerEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/MarkdownClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/markdown/client/MarkdownEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/slider/client/SliderClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/slider/client/SliderEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/select/client/SelectClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/select/client/SelectEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/grid/client/GridClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/grid/client/GridEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/sortable/client/SortableClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/sortable/client/SortableEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/dashboard/client/DashboardClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/dashboard/client/DashboardEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/gallery/client/GalleryClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/gallery/client/GalleryEntryPoint.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/richtext/client/RichTextClientBundle.java</exclude>
            <exclude>io/instanto/bootstrap5/extras/richtext/client/RichTextEntryPoint.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-bootstrap5-source-seams</id>
            <phase>process-sources</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <files>
                    <file>${project.build.directory}/shared-sources/io/instanto/bootstrap5/client/GwtBootstrap5EntryPoint.java</file>
                    <file>${project.basedir}/src/main/java/io/instanto/bootstrap5/client/TeaVmBootstrap5EntryPoint.java</file>
                  </files>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-extra-scripts</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm/js</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/extras/markdown/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/extras/slider/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/extras/richtext/client/resource/js</directory>
                  <includes>
                    <include>*.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-extra-stylesheets</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm/css</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/extras/slider/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/extras/richtext/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/themes/client/resource/css</directory>
                  <includes>
                    <include>*.css</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-icon-fonts</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/teavm/fonts</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/shared-sources/io/instanto/bootstrap5/client/resource/fonts</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-teavm-bootstrap5-smoke-app</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <mainClass>io.instanto.bootstrap5.teavm.demo.SharedShowcaseApp</mainClass>
              <targetDirectory>${project.build.directory}/teavm</targetDirectory>
              <targetFileName>teavm-bootstrap5-smoke.js</targetFileName>
              <minifying>true</minifying>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
