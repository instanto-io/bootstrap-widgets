<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>teavm-bootstrap-widgets</artifactId>
  <packaging>pom</packaging>
  <name>TeaVM Bootstrap Widgets</name>
  <modules>
    <module>teavm-gwt-compat</module>
    <module>teavm-bootstrap3</module>
    <module>teavm-bootstrap5</module>
    <module>teavm-bootstrap-widget-tests</module>
  </modules>
  <properties>
    <!-- Shared-source files a TeaVM module leaves out when it unpacks the GWT
         sources: GWT-only halves of a seam whose TeaVM half is generated, such as
         a module's hand-written GWT XResources loader. Comma-separated. -->
    <shared.source.gwt.only>META-INF/**</shared.source.gwt.only>
  </properties>
  <build>
    <resources>
      <resource>
        <directory>${project.build.directory}/shared-sources</directory>
        <includes>
          <include>**/resource/**</include>
          <!-- The Java is compiled from teavm-sources, which holds only .java files,
               so the UiBinder processor finds templates on the class path instead. -->
          <include>**/*.ui.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <executions>
            <execution>
              <id>unpack-shared-sources</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>unpack-dependencies</goal>
              </goals>
              <configuration>
                <classifier>sources</classifier>
                <includeArtifactIds>${shared.source.artifacts}</includeArtifactIds>
                <outputDirectory>${project.build.directory}/shared-sources</outputDirectory>
                <overWriteSnapshots>true</overWriteSnapshots>
                <excludes>META-INF/**,${shared.source.gwt.only}</excludes>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <!-- The GWT sources reach JavaScript through JsInterop. teavm-compat's
             binding generator rewrites those declarations as TeaVM JSO, so TeaVM
             compiles the same source rather than a hand-kept copy. The output,
             teavm-sources, is what a module compiles instead of shared-sources. -->
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>adapt-shared-sources</id>
              <phase>process-sources</phase>
              <goals>
                <goal>java</goal>
              </goals>
              <configuration>
                <mainClass>io.instanto.compat.GenerateBindings</mainClass>
                <includeProjectDependencies>false</includeProjectDependencies>
                <includePluginDependencies>true</includePluginDependencies>
                <arguments>
                  <argument>${project.build.directory}/teavm-sources</argument>
                  <argument>${project.build.directory}/shared-sources</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
          <dependencies>
            <dependency>
              <groupId>io.instanto</groupId>
              <artifactId>jsinterop-binding-generator</artifactId>
              <version>${teavm-compat.version}</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>exclude-gwt-runtime-from-teavm</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>org.gwtproject:gwt-user</exclude>
                    <exclude>org.gwtproject:gwt-dev</exclude>
                    <exclude>com.google.gwt:gwt-user</exclude>
                    <exclude>com.google.gwt:gwt-dev</exclude>
                  </excludes>
                  <message>TeaVM modules must use gwt-user-compat, never gwt-user or gwt-dev.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
