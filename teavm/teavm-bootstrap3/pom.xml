<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>teavm-bootstrap-widgets</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>teavm-bootstrap3</artifactId>
  <name>TeaVM Bootstrap 3</name>
  <packaging>jar</packaging>
  <description>TeaVM-backed Bootstrap 3 widget API, sharing the GWT track sources.</description>
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3-extras</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3-themes</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>gwt-bootstrap3-showcase</artifactId>
      <version>${project.version}</version>
      <classifier>sources</classifier>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>gwt-user-compat</artifactId>
    </dependency>
    <!-- The TeaVM side of the JsInterop the shared sources use, and the annotations,
         which the binding generator leaves imported. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>jsinterop-base-compat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.jsinterop</groupId>
      <artifactId>jsinterop-annotations</artifactId>
      <version>${jsinterop.annotations.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>
  <properties>
    <!-- Sources vendored from GWTBootstrap3. Formatting them would produce a
         permanent diff against upstream, and one file already breaks the
         formatter by separating its imports with a comment. -->
    <spotless.apply.skip>true</spotless.apply.skip>
    <spotless.check.skip>true</spotless.check.skip>
    <shared.source.artifacts>gwt-bootstrap3,gwt-bootstrap3-themes,gwt-bootstrap3-showcase</shared.source.artifacts>
    <!-- GWT halves of seams whose TeaVM halves are generated or hand-kept: the loaders, and
         Summernote, whose JsArray of image overlays has no portable form. -->
    <shared.source.gwt.only>META-INF/**,org/gwtbootstrap3/client/Bootstrap3.java,org/gwtbootstrap3/extras/toggleswitch/client/ToggleSwitchResourcesResources.java,org/gwtbootstrap3/extras/slider/client/SliderResourcesResources.java,org/gwtbootstrap3/extras/select/client/SelectResourcesResources.java,org/gwtbootstrap3/extras/markdown/client/MarkdownResources.java,org/gwtbootstrap3/extras/summernote/client/ui/base/SummernoteJs.java,org/gwtbootstrap3/extras/summernote/client/event/SummernoteImageUploadEvent.java</shared.source.gwt.only>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>io.instanto</groupId>
        <artifactId>gwt-resources-compat-maven-plugin</artifactId>
        <version>${teavm-compat.version}</version>
        <executions>
          <execution>
            <id>generate-teavm-modules</id>
            <phase>process-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/shared-sources</sourceRoot>
              <outputRoot>${project.build.directory}/generated-sources/teavm-modules</outputRoot>
              <assetRoot>${project.build.directory}/teavm</assetRoot>
              <packagedRoot>${project.build.outputDirectory}/META-INF/bootstrap3-assets</packagedRoot>
              <resourcesClass>org.gwtbootstrap3.client.Bootstrap3Resources</resourcesClass>
              <idPrefix>gwtbootstrap3-</idPrefix>
              <scriptPresence>
                <jquery-3.7.1.min.cache.js>org.gwtbootstrap3.client.TeaVmBootstrap3EntryPoint::isJQueryLoaded</jquery-3.7.1.min.cache.js>
                <bootstrap-3.4.1.min.cache.js>org.gwtbootstrap3.client.TeaVmBootstrap3EntryPoint::isBootstrapLoaded</bootstrap-3.4.1.min.cache.js>
              </scriptPresence>
              <includeModules>
                <includeModule>NoThemeResources</includeModule>
                <includeModule>Markdown</includeModule>
                <includeModule>SliderResources</includeModule>
                <includeModule>SelectResources</includeModule>
                <includeModule>SummernoteResources</includeModule>
                <includeModule>ToggleSwitchResources</includeModule>
                <includeModule>CardResources</includeModule>
                <includeModule>AnimateResources</includeModule>
              </includeModules>
              <inlineTextBundles>
                <inlineTextBundle>org.gwtbootstrap3.extras.select.client.SelectClientBundle</inlineTextBundle>
                <inlineTextBundle>org.gwtbootstrap3.extras.summernote.client.SummernoteClientBundle</inlineTextBundle>
              </inlineTextBundles>
            </configuration>
          </execution>
          <!-- The GWT sources still use JSNI, with callbacks as JsInterop functions.
               adapt-sources rewrites both for TeaVM, so TeaVM compiles the same source
               rather than a hand-kept copy; the compiler reads teavm-sources below. -->
          <execution>
            <id>adapt-shared-sources</id>
            <goals>
              <goal>adapt-sources</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/shared-sources</sourceRoot>
              <outputRoot>${project.build.directory}/teavm-sources</outputRoot>
              <legacyJsni>true</legacyJsni>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-ported-bootstrap3-extras</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <classifier>sources</classifier>
              <includeArtifactIds>gwt-bootstrap3-extras</includeArtifactIds>
              <includes>org/gwtbootstrap3/extras/animate/**,org/gwtbootstrap3/extras/card/**,org/gwtbootstrap3/extras/markdown/**,org/gwtbootstrap3/extras/toggleswitch/**,org/gwtbootstrap3/extras/slider/**,org/gwtbootstrap3/extras/select/**,org/gwtbootstrap3/extras/summernote/**</includes>
              <excludes>${shared.source.gwt.only}</excludes>
              <outputDirectory>${project.build.directory}/shared-sources</outputDirectory>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-shared-bootstrap3-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/teavm-sources</source>
                <source>${project.build.directory}/generated-sources/teavm-modules</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>io.instanto</groupId>
              <artifactId>widget-processor</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
          <excludes>
            <exclude>org/gwtbootstrap3/demo/client/ExtrasPages.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/ShowcaseScripts.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/GwtBootstrap3DemoClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/AnimateView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/BootboxJSView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/CardView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/DatePickerView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/DateTimePickerView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/FullCalendarView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/GalleryView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/MarkdownView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/NotifyView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/OfflineView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/TagsInputView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/extras/TypeaheadView.java</exclude>
            <exclude>org/gwtbootstrap3/demo/client/application/css/validation/**</exclude>
            <exclude>org/gwtbootstrap3/extras/toggleswitch/client/ToggleSwitchClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/extras/toggleswitch/client/ToggleSwitchEntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/extras/slider/client/SliderClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/extras/slider/client/SliderEntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/extras/select/client/SelectEntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/extras/summernote/client/ui/base/SummernoteJs.java</exclude>
            <exclude>org/gwtbootstrap3/extras/summernote/client/event/SummernoteImageUploadEvent.java</exclude>
            <exclude>org/gwtbootstrap3/extras/summernote/client/SummernoteEntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/extras/markdown/client/MarkdownClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/extras/markdown/client/MarkdownEntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/client/GwtBootstrap3EntryPoint.java</exclude>
            <exclude>org/gwtbootstrap3/client/GwtBootstrap3ClientBundle.java</exclude>
            <exclude>org/gwtbootstrap3/client/shared/js/JQuery.java</exclude>
            <exclude>org/gwtbootstrap3/client/ui/base/TooltipOptions.java</exclude>
            <exclude>org/gwtbootstrap3/client/ui/base/CarouselOptions.java</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-bootstrap3-source-seams</id>
            <phase>process-sources</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireFilesExist>
                  <!-- Every compiler exclusion still names a GWT source, so an exclusion cannot
                       silently outlive the file it was written for. -->
                  <files>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/ExtrasPages.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/ShowcaseScripts.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/GwtBootstrap3DemoClientBundle.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/AnimateView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/BootboxJSView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/CardView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/DatePickerView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/DateTimePickerView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/FullCalendarView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/GalleryView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/MarkdownView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/NotifyView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/OfflineView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/TagsInputView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/extras/TypeaheadView.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-showcase/src/main/java/org/gwtbootstrap3/demo/client/application/css/validation</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/toggleswitch/client/ToggleSwitchClientBundle.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/toggleswitch/client/ToggleSwitchEntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/slider/client/SliderClientBundle.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/slider/client/SliderEntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/select/client/SelectEntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/summernote/client/ui/base/SummernoteJs.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/summernote/client/event/SummernoteImageUploadEvent.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/summernote/client/SummernoteEntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/markdown/client/MarkdownClientBundle.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3-extras/src/main/java/org/gwtbootstrap3/extras/markdown/client/MarkdownEntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3/src/main/java/org/gwtbootstrap3/client/GwtBootstrap3EntryPoint.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3/src/main/java/org/gwtbootstrap3/client/GwtBootstrap3ClientBundle.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3/src/main/java/org/gwtbootstrap3/client/shared/js/JQuery.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3/src/main/java/org/gwtbootstrap3/client/ui/base/TooltipOptions.java</file>
                    <file>${project.parent.parent.basedir}/gwt/gwt-bootstrap3/src/main/java/org/gwtbootstrap3/client/ui/base/CarouselOptions.java</file>
                  </files>
                </requireFilesExist>
                <requireFilesExist>
                  <!-- The TeaVM halves of the seams that remain. -->
                  <files>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/Bootstrap3.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/shared/js/JQuery.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/ui/base/CarouselOptions.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/ui/base/TooltipOptions.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/demo/client/ExtrasPages.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/demo/client/ShowcaseScripts.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/extras/summernote/client/event/SummernoteImageUploadEvent.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/extras/summernote/client/ui/base/SummernoteJs.java</file>
                    <file>${project.basedir}/src/main/java/org/gwtbootstrap3/client/TeaVmBootstrap3EntryPoint.java</file>
                  </files>
                </requireFilesExist>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <id>compile-teavm-showcase-app</id>
            <phase>process-classes</phase>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <mainClass>org.gwtbootstrap3.teavm.demo.SharedShowcaseApp</mainClass>
              <targetDirectory>${project.build.directory}/teavm</targetDirectory>
              <targetFileName>teavm-bootstrap3-showcase.js</targetFileName>
              <minifying>true</minifying>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
