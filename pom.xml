<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>instanto-teavm-pom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>
  <groupId>io.instanto</groupId>
  <artifactId>bootstrap-widgets</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Bootstrap Widgets</name>
  <description>Bootstrap 3 and Bootstrap 5 widget libraries for GWT and TeaVM.</description>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <organization>
    <name>GWT Bootstrap</name>
    <url>https://github.com/cstainton/bootstrap-widgets</url>
  </organization>
  <scm>
    <url>https://github.com/instanto-io/bootstrap-widgets</url>
    <connection>scm:git:https://github.com/instanto-io/bootstrap-widgets.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/instanto-io/bootstrap-widgets.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <repositories>
    <repository>
      <id>forgejo</id>
      <name>Instanto snapshots</name>
      <url>https://packages.instanto.io/api/packages/instanto-io/maven</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/cstainton/bootstrap-widgets</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>github-cucumber-tea</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/cstainton/cucumber-tea</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>github-gherkin-tea</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/cstainton/gherkin-tea</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>github-mockatcha</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/cstainton/mockatcha</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>

  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>forgejo</id>
      <name>Instanto snapshot build plugins</name>
      <url>https://packages.instanto.io/api/packages/instanto-io/maven</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </pluginRepository>
  </pluginRepositories>
  <modules>
    <module>widget-processor</module>
    <module>gwt</module>
    <module>testing</module>
    <module>teavm</module>
    <module>showcase-site</module>
  </modules>
  <properties>
    <dependency-check-maven.version>12.1.0</dependency-check-maven.version>
    <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <exec-maven-plugin.version>3.6.3</exec-maven-plugin.version>
    <!-- Source maps of the showcase applications: build-tools/SourceMaps.java makes them
         usable from the published site and fails when a mapped source is missing. An
         application module sets the phase, mode and path; CI sets source.maps.flag to require output,
         so output that was never compiled fails instead of being skipped. -->
    <source.maps.phase>none</source.maps.phase>
    <source.maps.mode>gwt</source.maps.mode>
    <source.maps.path>${project.build.directory}</source.maps.path>
    <source.maps.flag></source.maps.flag>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <gwt-maven-plugin.version>1.3.0</gwt-maven-plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <gwt.version>2.13.1</gwt.version>
    <jsinterop.base.version>1.0.1</jsinterop.base.version>
    <jsinterop.annotations.version>2.0.2</jsinterop.annotations.version>
    <bootstrap.version>3.4.1</bootstrap.version>
    <bootstrap5.version>5.3.8</bootstrap5.version>
    <jquery.compat.version>3.7.1</jquery.compat.version>
    <bootbox.version>6.0.4</bootbox.version>
    <bootstrap.datepicker.version>1.10.1</bootstrap.datepicker.version>
    <bootstrap.datetimepicker.version>2.4.4</bootstrap.datetimepicker.version>
    <bootstrap.select.version>1.14.0-beta3</bootstrap.select.version>
    <bootstrap.slider.version>11.0.2</bootstrap.slider.version>
    <bootstrap.switch.version>3.4.0</bootstrap.switch.version>
    <typeahead.version>0.11.1</typeahead.version>
    <animate.version>4.1.1</animate.version>
    <summernote.version>0.9.1</summernote.version>
    <fullcalendar.version>3.10.5</fullcalendar.version>
    <jquery.ui.version>1.13.3</jquery.ui.version>
    <moment.version>2.30.1</moment.version>
    <blueimp.gallery.version>3.4.0</blueimp.gallery.version>
    <tomselect.version>2.6.2</tomselect.version>
    <tabulator.version>6.5.2</tabulator.version>
    <sortable.version>1.15.7</sortable.version>
    <gridstack.version>13.2.0</gridstack.version>
    <photoswipe.version>5.4.4</photoswipe.version>
    <junit.version>4.13.2</junit.version>
    <teavm.junit.js.runner>browser-chrome</teavm.junit.js.runner>
    <cucumber-tea.version>0.1.0-SNAPSHOT</cucumber-tea.version>
    <mockatcha.version>0.1.0-SNAPSHOT</mockatcha.version>
    <webapp-testkit.version>0.1.0-SNAPSHOT</webapp-testkit.version>
    <teavm-compat.version>0.1.0-SNAPSHOT</teavm-compat.version>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.9.6.0</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <xmlOutput>true</xmlOutput>
          <spotbugsXmlOutputDirectory>${project.build.directory}/spotbugs</spotbugsXmlOutputDirectory>
          <spotbugsXmlOutputFilename>${project.artifactId}-spotbugs.xml</spotbugsXmlOutputFilename>
          <sarifOutput>true</sarifOutput>
          <sarifOutputDirectory>${project.build.directory}/spotbugs</sarifOutputDirectory>
          <sarifOutputFilename>${project.artifactId}-spotbugs.sarif</sarifOutputFilename>
          <htmlOutput>true</htmlOutput>
          <outputDirectory>${project.build.directory}/spotbugs</outputDirectory>
          <failOnError>true</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>spotbugs-report</id>
            <phase>process-classes</phase>
            <goals>
              <goal>spotbugs</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>name-spotbugs-html-report</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <move todir="${project.build.directory}/spotbugs">
                  <fileset dir="${project.build.directory}/spotbugs" includes="spotbugs.html" erroronmissingdir="false" />
                  <globmapper from="spotbugs.html" to="${project.artifactId}-spotbugs.html" />
                </move>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>${maven-source-plugin.version}</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>prepare-source-maps</id>
              <phase>${source.maps.phase}</phase>
              <goals>
                <goal>exec</goal>
              </goals>
              <configuration>
                <executable>${java.home}/bin/java</executable>
                <arguments>
                  <argument>${project.parent.parent.basedir}/build-tools/SourceMaps.java</argument>
                  <argument>${source.maps.mode}</argument>
                  <argument>${source.maps.path}</argument>
                  <argument>${source.maps.flag}</argument>
                </arguments>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <profile>
      <id>dependency-audit</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <configuration>
              <nvdApiKey>${nvdApiKey}</nvdApiKey>
              <failBuildOnCVSS>11</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>JSON</format>
                <format>SARIF</format>
              </formats>
              <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
              <skipProvidedScope>true</skipProvidedScope>
              <skipTestScope>true</skipTestScope>
              <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.instanto</groupId>
        <artifactId>teavm-compat-bom</artifactId>
        <version>${teavm-compat.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
